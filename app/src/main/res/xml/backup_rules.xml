<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Unified state includes credentials and panel-local recovery/controller state; it must only leave
         through the sealed backup flow if implicit Android backup is ever re-enabled. -->
    <exclude domain="database" path="." />
    <exclude domain="database" path="ha-paneld.db" />
    <!-- Screenshots are transient panel observations, not portable application state. -->
    <exclude domain="file" path="panel-screenshots/" />
    <exclude domain="file" path="last-panel-screenshot.png" />
    <!-- Revision snapshots contain historical credentials as well as ordinary settings. -->
    <exclude domain="file" path="config-revisions/" />
</full-backup-content>
